{
  "name": "karyora-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Unified AI Work Platform \u2014 shared UI shell and approved navigation (UI Phase 2, P2.6).",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
