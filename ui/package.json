    "types:generate": "openapi-typescript ../contracts/openapi.yaml --output src/coreclient/generated-eval-surface/eval-surface.d.ts",
    "types:check": "node scripts/check-eval-surface-drift.mjs"
  },
  "dependencies": {
    "i18next": "26.5.12",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
