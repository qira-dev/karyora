{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qira.dev/karyora/contracts/schemas/knowledgepack-manifest-v1.schema.json",
  "title": "KnowledgePack manifest v1 (internal profile)",
  "description": "Versioned KnowledgePack manifest for the Core (C3-03/C3-04). This is the internal profile only: public/portable compatibility claims stay behind gate D-41. Readers refuse newer or unknown schema_version values fail-closed.",
  "type": "object",
  "required": ["schema_version", "pack_id", "pack_version", "title", "source", "license", "license_status", "trust", "entries", "claims", "evidence"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "pack_id": { "type": "string", "minLength": 1 },
    "pack_version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["kind", "identity", "locator", "captured_at"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["file", "url", "archive", "manual"] },
        "identity": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "captured_at": { "type": "string", "format": "date-time" }
      }
    },
    "license": { "type": "string" },
    "license_status": { "enum": ["known", "unknown"] },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy_ref": { "type": "string" },
        "assessed_at": { "type": "string", "format": "date-time" },
        "stale_after_secs": { "type": "integer", "minimum": 0 }
      }
    },
    "trust": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": { "enum": ["unsigned", "verified", "revoked", "quarantined"] },
        "signer_id": { "type": "string" }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "content_type", "size_bytes", "digest"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$)).+$",
            "description": "Normalized pack-relative path: forward slashes only, no absolute, dot, or dot-dot segments."
          },
          "content_type": { "type": "string", "minLength": 1 },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "statement", "status", "evidence_ids"],
        "additionalProperties": false,
        "properties": {
          "claim_id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "status": { "enum": ["active", "superseded", "conflicted", "revoked"] },
          "evidence_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "supersedes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "generated": { "type": "boolean" },
          "generated_ref": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "kind", "locator", "captured_at", "trust_state"],
        "additionalProperties": false,
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "locator": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "captured_at": { "type": "string", "format": "date-time" },
          "trust_state": { "enum": ["unsigned", "verified", "revoked", "quarantined"] }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_ref", "type", "to_ref"],
        "additionalProperties": false,
        "properties": {
          "from_ref": { "type": "string", "pattern": "^(claim|evidence|entry):.+$" },
          "type": { "enum": ["supports", "contradicts", "supersedes", "derives"] },
          "to_ref": { "type": "string", "pattern": "^(claim|evidence|entry):.+$" }
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
